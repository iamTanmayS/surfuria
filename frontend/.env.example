# ==============================================================================
# SURFURIA — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development with `npm run dev`:
#   cp .env.example .env.local
#
# For production deployments on Vercel:
#   Add these variables under Project Settings > Environment Variables
# ==============================================================================

# Server-Side Brevo Credentials (Required for /api/contact and /api/newsletter)
# NEVER prefix these with VITE_ — they are strictly server-side.
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=info@yourdomain.com
BREVO_SENDER_NAME=Surfuria
CONTACT_RECIPIENT_EMAIL=info@surfuria.com

# WhatsApp Business Configuration (Exposed to client components)
VITE_WHATSAPP_NUMBER=919424602091
WHATSAPP_NUMBER=919424602091

# Social Media Profiles (Exposed to client components; leave blank to disable)
VITE_SOCIAL_INSTAGRAM_URL=https://instagram.com/surfuria
VITE_SOCIAL_PINTEREST_URL=https://pinterest.com/surfuria
VITE_SOCIAL_LINKEDIN_URL=https://linkedin.com/company/surfuria
VITE_SOCIAL_FACEBOOK_URL=https://facebook.com/surfuria
VITE_SOCIAL_X_URL=https://x.com/surfuria
